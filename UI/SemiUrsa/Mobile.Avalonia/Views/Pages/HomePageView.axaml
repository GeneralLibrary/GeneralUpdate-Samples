<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:td="https://irihi.tech/td"
             mc:Ignorable="d" d:DesignWidth="375" d:DesignHeight="812"
             x:Class="Sandbox.Views.Pages.HomePageView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <td:Home Mode="FilledMultiple" Width="60" Height="60" HorizontalAlignment="Center" />
        <TextBlock Text="首页（占位）" FontSize="16" />
    </StackPanel>
</UserControl>