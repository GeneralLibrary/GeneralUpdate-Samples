<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeneralUpdate.Samples.Semi.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GeneralUpdate.Samples.Semi.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GeneralUpdate.Samples.Semi.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://GeneralUpdate.Samples.Shared/Assets/irihi.ico"
        RequestedThemeVariant="Dark"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen"
        Title="General Update 客户端">
    <views:MainView />
</Window>