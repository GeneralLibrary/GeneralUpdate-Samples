<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:td="https://irihi.tech/td"
             mc:Ignorable="d" d:DesignWidth="375" d:DesignHeight="812"
             x:Class="GeneralUpdate.Samples.Mafia.Views.Pages.HomePageView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <Image
            Width="150"
            Height="150"
            Source="avares://GeneralUpdate.Samples.Shared/Assets/GeneralUpdate.png" />
        <td:Close Width="60" Height="60" />
        <iri:IrihiBand Label="Mafia" Fill="{DynamicResource TDBrandColor}" Width="250" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>