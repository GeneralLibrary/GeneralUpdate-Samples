<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GeneralUpdate.Samples.Mafia.ViewModels"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:td="https://irihi.tech/td"
             mc:Ignorable="d" d:DesignWidth="375" d:DesignHeight="812"
             x:Class="GeneralUpdate.Samples.Mafia.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Panel>
        <ScrollViewer>
            <StackPanel>
                <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,24,16,20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <m:Avatar Grid.Column="0" Content="G" Margin="12" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="General Update Demo" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="移动端自动升级演示" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <m:CellGroup Header="通用">
                    <m:Picker
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                        Description="主题" />
                    <m:Cell
                        Content="检查更新"
                        Description="检测是否有新版本"
                        Classes="Arrow"
                        Command="{Binding CheckUpdateCommand}" />
                </m:CellGroup>

                <m:CellGroup Header="关于">
                    <m:Cell Content="当前版本" Note="{Binding CurrentVersion}" />
                    <m:Cell Content="更新引擎" Note="GeneralUpdate" />
                </m:CellGroup>
            </StackPanel>
        </ScrollViewer>

        <m:Popup
            IsOpen="{Binding IsCheckUpdatePopupOpen}"
            IsModal="True"
            IsLightDismissEnabled="False"
            Placement="Bottom">
            <Border
                Background="{DynamicResource TDBgColorContainer}"
                CornerRadius="16,16,0,0"
                Padding="20,24">
                <StackPanel Spacing="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="发现新版本"
                        FontSize="18"
                        FontWeight="Bold" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run Text="检测到新版本 " />
                        <Run Text="{Binding Statistics.Version}" FontWeight="Bold" />
                        <Run Text=" 是否立即更新?" />
                    </TextBlock>
                    <UniformGrid Columns="2" ColumnSpacing="12">
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="取消"
                            Command="{Binding CancelUpdateCommand}" />
                        <Button
                            Classes="Primary"
                            HorizontalAlignment="Stretch"
                            Content="确定"
                            Command="{Binding ConfirmUpdateCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </m:Popup>

        <m:Popup
            IsOpen="{Binding IsDownloadPopupOpen}"
            IsModal="True"
            IsLightDismissEnabled="False"
            Placement="Bottom">
            <Border
                Background="{DynamicResource TDBgColorContainer}"
                CornerRadius="16,16,0,0"
                Padding="20,24">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="正在下载更新"
                            FontSize="18"
                            FontWeight="Bold" />
                        <m:IconButton
                            Grid.Column="1"
                            Classes="Circle"
                            Command="{Binding CancelUpdateCommand}">
                            <m:IconButton.Icon>
                                <td:Close />
                            </m:IconButton.Icon>
                        </m:IconButton>
                    </Grid>
                    <ProgressBar
                        Value="{Binding Statistics.ProgressPercentage}"
                        Maximum="100"
                        ShowProgressText="True">
                        <ProgressBar.Styles>
                            <Style Selector="ProgressBar">
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <DoubleTransition Easing="CubicEaseInOut" Property="Value" Duration="0:0:0.3" />
                                    </Transitions>
                                </Setter>
                            </Style>
                        </ProgressBar.Styles>
                    </ProgressBar>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding Statistics.Speed, StringFormat='下载速度：{0:F2} MB/s'}" />
                </StackPanel>
            </Border>
        </m:Popup>

        <m:Popup
            IsOpen="{Binding IsInstallPopupOpen}"
            IsModal="True"
            IsLightDismissEnabled="False"
            Placement="Bottom">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16,16,0,0"
                    Padding="20,24">
                <StackPanel Spacing="16">
                    <td:Check Width="40" Height="40" HorizontalAlignment="Center" />
                    <TextBlock Text="下载完成" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center">
                        <Run Text="新版本 " />
                        <Run Text="{Binding Statistics.Version}" FontWeight="Bold" />
                        <Run Text=" 已下载，是否立即安装?" />
                    </TextBlock>
                    <UniformGrid Columns="2" ColumnSpacing="12">
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="取消"
                            Command="{Binding InstallCancelCommand}" />
                        <Button
                            Classes="Primary"
                            HorizontalAlignment="Stretch"
                            Content="确定"
                            Command="{Binding InstallConfirmCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </m:Popup>
    </Panel>
</UserControl>